<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Portfolio Admin</title>
  <style>
    *{box-sizing:border-box;margin:0}
    body{font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:#0f172a;color:#0f172a;font-size:15px;display:grid;place-items:center;min-height:100vh}
    a{color:#4f46e5;text-decoration:none}
    .card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:28px;width:min(380px,92vw)}
    h2{margin-bottom:6px}
    .sub{color:#64748b;font-size:13px;margin-bottom:18px}
    .flash{padding:11px 14px;border-radius:8px;margin-bottom:16px;font-weight:500;font-size:14px}
    .flash.error{background:#fee2e2;color:#991b1b;border:1px solid #fca5a5}
    .flash.success{background:#dcfce7;color:#166534;border:1px solid #86efac}
    .field{margin-bottom:16px}
    .field label{display:block;font-weight:600;font-size:13px;margin-bottom:6px;color:#334155}
    .field input[type=text],.field input[type=password]{width:100%;padding:10px 12px;border:1px solid #cbd5e1;border-radius:8px;font:inherit}
    .btn{display:inline-block;padding:10px 16px;border-radius:8px;border:1px solid transparent;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;width:100%}
    .btn-primary{background:#4f46e5;color:#fff}
    .btn-primary:hover{background:#4338ca}
  </style>
</head>
<body>
  <%- include(body) %>
</body>
</html>
