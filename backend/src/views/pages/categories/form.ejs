<div class="card" style="max-width:640px">
  <h2 style="margin-bottom:16px"><%= record ? 'Edit Category' : 'Tambah Category' %></h2>
  <form method="post" action="<%= record ? `${base}/${record.id}/update` : base %>">
    <div class="field">
      <label for="key">Key</label>
      <input type="text" id="key" name="key" value="<%= old.key ?? record?.key ?? '' %>" required maxlength="100"
             pattern="[a-z0-9_-]+" title="Hanya huruf kecil, angka, - dan _">
      <% if (errors?.key) { %><p class="field-error"><%= errors.key %></p><% } %>
      <p class="hint">Unik, dipakai filter API (?category=<key>). Contoh: web_app</p>
    </div>

    <div class="field">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" value="<%= old.title ?? record?.title ?? '' %>" required maxlength="100">
      <% if (errors?.title) { %><p class="field-error"><%= errors.title %></p><% } %>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Simpan</button>
      <a class="btn btn-outline" href="<%= base %>">Batal</a>
    </div>
  </form>
</div>