<div class="toolbar"><h2>Ringkasan Data</h2></div>

<div class="grid-stats">
  <a class="stat" href="/admin/tools"><div class="num"><%= stats.tools %></div><div class="lbl">Tools</div></a>
  <a class="stat" href="/admin/projects"><div class="num"><%= stats.projects %></div><div class="lbl">Projects</div></a>
  <a class="stat" href="/admin/categories"><div class="num"><%= stats.categories %></div><div class="lbl">Categories</div></a>
  <a class="stat" href="/admin/certificates"><div class="num"><%= stats.certificates %></div><div class="lbl">Certificates</div></a>
  <a class="stat" href="/admin/profile">
    <div class="num"><%= stats.hasProfile ? '✓' : '—' %></div>
    <div class="lbl">Profil<%= stats.hasProfile && stats.profileName ? ` (${stats.profileName})` : '' %></div>
  </a>
  <div class="stat"><div class="num"><%= stats.admins %></div><div class="lbl">Akun Admin</div></div>
</div>

<div class="card">
  <h3 style="margin-bottom:12px">Aksi Cepat</h3>
  <div style="display:flex;gap:10px;flex-wrap:wrap">
    <a class="btn btn-primary btn-sm" href="/admin/tools/create">+ Tool</a>
    <a class="btn btn-primary btn-sm" href="/admin/projects/create">+ Project</a>
    <a class="btn btn-primary btn-sm" href="/admin/categories/create">+ Category</a>
    <a class="btn btn-primary btn-sm" href="/admin/certificates/create">+ Certificate</a>
    <a class="btn btn-outline btn-sm" href="/admin/profile">Edit Profil</a>
  </div>
</div>