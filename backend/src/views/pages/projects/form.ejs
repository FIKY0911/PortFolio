<div class="card" style="max-width:800px">
  <h2 style="margin-bottom:16px"><%= record ? 'Edit Project' : 'Tambah Project' %></h2>
  <form method="post"
        action="<%= record ? `${base}/${record.id}/update` : base %>"
        enctype="multipart/form-data">
    <div class="field">
      <label for="title">Judul</label>
      <input type="text" id="title" name="title" value="<%= old.title ?? record?.title ?? '' %>" required maxlength="150">
      <% if (errors?.title) { %><p class="field-error"><%= errors.title %></p><% } %>
    </div>

    <div class="field">
      <label for="referanceUrl">Referensi URL</label>
      <input type="url" id="referanceUrl" name="referanceUrl" value="<%= old.referanceUrl ?? record?.referanceUrl ?? '' %>" placeholder="https://...">
      <% if (errors?.referanceUrl) { %><p class="field-error"><%= errors.referanceUrl %></p><% } %>
      <p class="hint">URL demo/live (opsional)</p>
    </div>

    <div class="field">
      <label for="githubUrl">GitHub URL</label>
      <input type="url" id="githubUrl" name="githubUrl" value="<%= old.githubUrl ?? record?.githubUrl ?? '' %>" placeholder="https://github.com/...">
      <% if (errors?.githubUrl) { %><p class="field-error"><%= errors.githubUrl %></p><% } %>
      <p class="hint">URL repo GitHub (opsional)</p>
    </div>

    <div class="field">
      <label for="description">Deskripsi</label>
      <textarea id="description" name="description"><%= old.description ?? record?.description ?? '' %></textarea>
    </div>

    <div class="field">
      <label for="categoryId">Kategori</label>
      <select id="categoryId" name="categoryId">
        <option value="">— Tanpa Kategori —</option>
        <% for (const c of categories) { %>
          <option value="<%= c.id %>" <%= String(old.categoryId ?? record?.categoryId ?? '') === String(c.id) ? 'selected' : '' %>>
            <%= c.title %> (<%= c.key %>)
          </option>
        <% } %>
      </select>
      <% if (errors?.categoryId) { %><p class="field-error"><%= errors.categoryId %></p><% } %>
    </div>

    <div class="field">
      <label>Tools</label>
      <div class="checks">
        <%
          /* dihitung sekali SEBELUM loop (hindari block-scope bug scriptlet EJS) */
          const chosen = (old.toolIds !== undefined
            ? [].concat(old.toolIds)
            : record?.tools?.map(x => x.id) ?? []
          ).map(String);
        %>
        <% for (const t of allTools) { %>
          <label>
            <input type="checkbox" name="toolIds" value="<%= t.id %>"
              <%= chosen.includes(String(t.id)) ? 'checked' : '' %>>
            <%= t.name %>
          </label>
        <% } %>
      </div>
      <% if (errors?.toolIds) { %><p class="field-error"><%= errors.toolIds %></p><% } %>
      <p class="hint">Centang tools yang dipakai project ini. Hidden input "" di bawah memastikan uncheck-all tetap mengirim array kosong.</p>
      <input type="hidden" name="toolIds" value="">
    </div>

    <div class="field preview">
      <label>Gambar Saat Ini</label>
      <% if (record?.imageUrl) { %><img src="<%= record.imageUrl %>" alt="<%= record.title %>">
      <% } else { %><p class="hint">Belum ada gambar.</p><% } %>
    </div>
    <div class="field">
      <label for="image">Gambar<% if (record) { %> <span class="hint">(kosongkan jika tidak diganti)</span><% } %></label>
      <input type="file" id="image" name="image" accept=".jpg,.jpeg,.png,.webp,.svg">
    </div>

    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Simpan</button>
      <a class="btn btn-outline" href="<%= base %>">Batal</a>
    </div>
  </form>
</div>