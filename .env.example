# Environment Variables
# Copy this file to .env and fill in your values
# Note: Vite requires variables to start with VITE_

# Base URL for the application (used for SEO canonical URLs, sitemap, etc.)
# Default: https://portfolio-fiky.vercel.app
VITE_APP_URL=https://portfolio-fiky.vercel.app

# Google Search Console verification code (optional)
# VITE_GOOGLE_VERIFICATION=YOUR_VERIFICATION_CODE
